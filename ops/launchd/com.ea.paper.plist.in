<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent that supervises one foreground `ea paper start`.

  This is a LaunchAgent, not a LaunchDaemon, on purpose: local Paper is a
  user-owned simulation of a user-owned Candidate, its runtime state lives
  under ~/EA, and it must neither run as root nor outlive the login session
  that owns those files.

  The supervised program is `ea-runtime run` invoked with the supervised flag
  declared in ProgramArguments below, which pins the operator's config and then
  `exec`s `ea paper start` in the foreground. `exec` keeps launchd's PID equal
  to the real Paper PID, so an abnormal kill of the job's process is an abnormal
  kill of the trading process, never a surviving orphan.

  No EnvironmentVariables block is declared deliberately. launchd starts a job
  with a clean environment, and `ea paper start` rejects EA_CONFIG_PATH,
  EA_ENVIRONMENT and any run mode other than `paper`; the runner also unsets
  those three explicitly rather than relying on that being incidental.

  Placeholders are substituted by `ea-runtime install`; this file is a template,
  never a live unit.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ea.paper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__SUPERVISOR_DIR__/ea-runtime</string>
    <string>run</string>
    <!--
      This flag is what makes the job the single writer: `ea-runtime run`
      without it is refused while this label is loaded, so a hand-run cannot
      become a second, unsupervised Paper process.
    -->
    <string>--supervised</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME_EA__</string>
  <key>RunAtLoad</key>
  <true/>
  <!--
    Restart only after an UNSUCCESSFUL exit, which is exactly launchd's own
    definition: a non-zero exit status or death by signal. A clean exit 0,
    which is what `ea paper stop` and cooperative SIGTERM produce, counts as a
    successful exit, so the job stays loaded but stopped and is never
    restarted. That is the whole crash-versus-intentional-stop distinction;
    there is no unconditional KeepAlive here and no external retry logic.
  -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <!-- launchd's own bound on how often this job may be started again. -->
  <key>ThrottleInterval</key>
  <integer>__THROTTLE_SECONDS__</integer>
  <key>StandardOutPath</key>
  <string>__HOME_EA__/logs/paper.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME_EA__/logs/paper.err.log</string>
</dict>
</plist>
